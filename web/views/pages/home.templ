package pages

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	{{ byYear := sighting.CountByYear(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Wildroot: wildlife sightings",
		Description: "Wildlife sightings from around the world, on a map and a timeline.",
	}) {
		<section class="hero" aria-labelledby="hero-title">
			@components.ThreeScene(components.ThreeSceneProps{Scene: "globe", Backdrop: true})
			@templ.JSONScript("globe-points", components.GlobePoints(sightings))
			<div class="hero__content">
				<p class="eyebrow">Wildlife, seen and shared</p>
				<h1 id="hero-title">Every sighting, rooted in a real place.</h1>
				<p class="hero__lead">Field records from people out watching lions, whales, turtles and macaws, with the weather on the day they were seen.</p>
				<div class="hero__actions">
					<a class="button button--lime" href="#sightings">Explore the timeline</a>
					<a class="button button--ghost" href="#map">See the map</a>
				</div>
			</div>
			if latest, ok := components.Latest(sightings); ok {
				<a class="hero__latest" href={ templ.SafeURL("#" + components.Anchor(latest)) }>
					@components.HeroPhoto(latest)
				</a>
			}
		</section>
		if len(sightings) == 0 {
			<section class="section empty" id="sightings">
				<h2>No sightings yet</h2>
				<p>Nothing has been recorded so far. Run <code>go run . db seed</code> to add some.</p>
			</section>
		} else {
			<section class="section numbers" id="numbers" aria-labelledby="numbers-title">
				<div class="section__head">
					<p class="eyebrow eyebrow--dark">The numbers</p>
					<h2 id="numbers-title">A living record of the wild</h2>
				</div>
				<div class="numbers__grid">
					<div class="stat">
						<span class="stat__value">{ strconv.Itoa(sum.Sightings) }</span>
						<span class="stat__label">sightings</span>
					</div>
					<div class="stat">
						<span class="stat__value">{ strconv.Itoa(sum.Species) }</span>
						<span class="stat__label">species</span>
					</div>
					<div class="stat">
						<span class="stat__value">{ strconv.Itoa(sum.Countries) }</span>
						<span class="stat__label">countries</span>
					</div>
					<div class="stat">
						<span class="stat__value">{ strconv.Itoa(sum.Recorders) }</span>
						<span class="stat__label">observers</span>
					</div>
					<div class="panel panel--spark">
						<h3>Sightings per year</h3>
						<p class="panel__note">{ strconv.Itoa(sum.Earliest.Year()) } to { strconv.Itoa(sum.Latest.Year()) }</p>
						@components.Sparkline(byYear, sum)
					</div>
					<div class="panel">
						<h3>Most-seen animals</h3>
						@components.Bars(components.TopAnimals(sightings, 5))
					</div>
					<div class="panel">
						<h3>Busiest countries</h3>
						@components.Bars(topCountries(sightings, 5))
					</div>
				</div>
			</section>
			<section class="section" id="map" aria-labelledby="map-title">
				<div class="section__head">
					<p class="eyebrow eyebrow--dark">Where</p>
					<h2 id="map-title">Seen across the globe</h2>
					<p>Zoom in to break up the groups. Click a dot to jump to its sighting below.</p>
				</div>
				@components.Map(components.MapProps{
					Points:  components.MapPoints(sightings),
					Cluster: true,
					Label:   "Map of where the sightings were. Every sighting is also listed in the timeline below.",
					Class:   "map--framed",
				})
			</section>
			<section class="section" id="sightings" aria-labelledby="sightings-title">
				<div class="section__head">
					<p class="eyebrow eyebrow--dark">When</p>
					<h2 id="sightings-title">The timeline</h2>
					<p>Newest first, year by year.</p>
				</div>
				@components.Timeline(sightings)
			</section>
		}
	}
}
